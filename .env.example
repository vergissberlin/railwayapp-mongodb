MONGO_INITDB_ROOT_USERNAME= # Set this in the Railway dashboard as a generated secret
MONGO_INITDB_ROOT_PASSWORD= # Set this in the Railway dashboard as a generated secret

# Optional: import a database dump on the first start of an empty volume.
# Must be a mongorestore --archive (mongodump --archive[--gzip]) file,
# not a mongodump --out directory tree. MONGO_INIT_DUMP_URL takes
# precedence if both are set. See README.md.
# MONGO_INIT_DUMP_URL=https://example.com/dumps/seed.archive.gz
# MONGO_INIT_DUMP_BASE64=
